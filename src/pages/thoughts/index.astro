---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import { createWebPageSchema, createBreadcrumbSchema } from "../../lib/seo";

const webPageSchema = createWebPageSchema(
  "Thoughts",
  "Reflections, notes, and half-formed ideas",
  "https://bastienfaivre.com/thoughts",
);

const breadcrumbSchema = createBreadcrumbSchema([
  { name: "Home", url: "https://bastienfaivre.com" },
  { name: "Thoughts" },
]);

const rawEntries = (
  await getCollection("thoughts", ({ data }) => !data.draft)
).sort((a, b) => {
  const dateDiff = b.data.date.getTime() - a.data.date.getTime();
  if (dateDiff !== 0) return dateDiff;
  return b.id.localeCompare(a.id);
});

const entries = await Promise.all(
  rawEntries.map(async (entry) => {
    const { Content } = await render(entry);
    return { entry, Content };
  }),
);

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<script>
  window.addEventListener("load", () => {
    const loader = document.querySelector(".loader") as HTMLElement;
    if (loader) {
      setTimeout(() => {
        loader.classList.add("loader-hidden");
      }, 100);
    }
  });
</script>

<script>
  const WIDE = "(min-width: 1480px)";

  // Rewrite footnote ids to a unique #<thought>-<note> since every thought shares this page
  function scopeFootnoteIds() {
    const rename = (thought: string, id: string) => {
      if (id.startsWith("user-content-fn-"))
        return `${thought}-${id.replace("user-content-fn-", "")}`;
      if (id === "footnote-label") return `${thought}-footnote-label`;
      return id;
    };

    document.querySelectorAll<HTMLElement>("section[id]").forEach((section) => {
      if (section.dataset.snScoped) return;
      const thought = section.id;

      section
        .querySelectorAll<HTMLElement>('[id^="user-content-fnref-"]')
        .forEach((el) => el.removeAttribute("id"));

      section
        .querySelectorAll<HTMLElement>('[id^="user-content-fn-"], [id="footnote-label"]')
        .forEach((el) => (el.id = rename(thought, el.id)));

      section
        .querySelectorAll<HTMLAnchorElement>('a[href^="#user-content-fn-"]')
        .forEach((a) =>
          a.setAttribute("href", "#" + rename(thought, a.getAttribute("href")!.slice(1))),
        );

      section
        .querySelectorAll<HTMLElement>('[aria-describedby="footnote-label"]')
        .forEach((el) =>
          el.setAttribute("aria-describedby", `${thought}-footnote-label`),
        );

      section.dataset.snScoped = "1";
    });
  }

  function layoutSidenotes() {
    const wide = window.matchMedia(WIDE).matches;

    document.querySelectorAll<HTMLElement>("article.thought").forEach((article) => {
      const footnotes = article.querySelector<HTMLElement>(".footnotes");
      if (!footnotes) return;
      const items = Array.from(
        footnotes.querySelectorAll<HTMLElement>("ol > li"),
      );

      if (!wide) {
        items.forEach((li) => (li.style.marginTop = ""));
        return;
      }

      items.forEach((li) => (li.style.marginTop = ""));

      const articleTop = article.getBoundingClientRect().top + window.scrollY;
      let cursor = articleTop;

      items.forEach((li) => {
        const ref = article.querySelector<HTMLElement>(
          `sup a[href="#${CSS.escape(li.id)}"]`,
        );
        const refTop = ref
          ? ref.getBoundingClientRect().top + window.scrollY
          : cursor;
        const target = Math.max(refTop, cursor);
        const liTop = li.getBoundingClientRect().top + window.scrollY;
        const delta = target - liTop;
        if (delta > 0) li.style.marginTop = `${delta}px`;
        cursor =
          li.getBoundingClientRect().top + window.scrollY + li.offsetHeight + 12;
      });
    });
  }

  function wireHighlights() {
    document.querySelectorAll<HTMLElement>("article.thought").forEach((article) => {
      article.querySelectorAll<HTMLElement>(".footnotes ol > li").forEach((li) => {
        const ref = article
          .querySelector<HTMLElement>(`sup a[href="#${CSS.escape(li.id)}"]`)
          ?.closest("sup");
        if (!ref) return;
        const on = () => {
          li.classList.add("sn-active");
          ref.querySelector("a")?.classList.add("sn-active");
        };
        const off = () => {
          li.classList.remove("sn-active");
          ref.querySelector("a")?.classList.remove("sn-active");
        };
        li.addEventListener("mouseenter", on);
        li.addEventListener("mouseleave", off);
        ref.addEventListener("mouseenter", on);
        ref.addEventListener("mouseleave", off);
      });
    });
  }

  function wireBackrefs() {
    document.querySelectorAll<HTMLElement>("article.thought").forEach((article) => {
      article
        .querySelectorAll<HTMLElement>(".footnotes a[data-footnote-backref]")
        .forEach((backref) => {
          const li = backref.closest("li");
          const marker = li
            ? article.querySelector<HTMLElement>(`sup a[href="#${CSS.escape(li.id)}"]`)
            : null;
          if (!marker) return;

          backref.removeAttribute("href");
          backref.setAttribute("role", "button");
          backref.setAttribute("tabindex", "0");
          backref.textContent = "↩︎";

          const go = () =>
            marker.scrollIntoView({ behavior: "smooth", block: "center" });
          backref.addEventListener("click", go);
          backref.addEventListener("keydown", (e) => {
            if (e.key === "Enter" || e.key === " ") {
              e.preventDefault();
              go();
            }
          });
        });
    });
  }

  scopeFootnoteIds();
  wireHighlights();
  wireBackrefs();
  layoutSidenotes();
  if (document.fonts?.ready) document.fonts.ready.then(layoutSidenotes);
  window.addEventListener("load", layoutSidenotes);

  let raf = 0;
  window.addEventListener("resize", () => {
    cancelAnimationFrame(raf);
    raf = requestAnimationFrame(layoutSidenotes);
  });
</script>

<style is:global>
  html {
    scroll-behavior: smooth;
  }

  article.thought :is(h2, h3, h4) {
    color: #f3f4f6;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }
  article.thought h2 {
    font-size: 1.25rem;
  }
  article.thought h3 {
    font-size: 1.1rem;
  }
  article.thought p {
    color: #e5e7eb;
    font-weight: 300;
    line-height: 1.7;
    margin: 0 0 1rem 0;
  }
  article.thought :is(strong, b) {
    font-weight: 700;
    color: #f3f4f6;
  }
  article.thought :is(em, i) {
    font-style: italic;
  }
  article.thought a {
    color: #8c2da5;
    text-decoration: none;
  }
  article.thought a:hover {
    text-decoration: underline;
  }
  article.thought ul,
  article.thought ol {
    color: #e5e7eb;
    font-weight: 300;
    line-height: 1.7;
    padding-left: 1.5rem;
    margin: 0 0 1rem 0;
  }
  article.thought code {
    background: #1f2937;
    color: #e5e7eb;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }
  article.thought pre {
    background: #0f172a;
    border: 1px solid #374151;
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin: 0 0 1rem 0;
  }
  article.thought pre code {
    background: transparent;
    padding: 0;
  }
  article.thought blockquote {
    border-left: 3px solid #4b5563;
    padding-left: 1rem;
    margin: 0 0 1rem 0;
    color: #d1d5db;
    font-style: italic;
  }

  .thought-anchor {
    color: #525252;
    opacity: 0;
    transition: opacity 0.15s;
    text-decoration: none;
    margin-left: 0.5rem;
    font-weight: 400;
  }
  .thought-heading:hover .thought-anchor,
  .thought-anchor:focus {
    opacity: 1;
  }
  @media (hover: none) {
    .thought-anchor {
      opacity: 1;
    }
  }
  :target > .thought-heading .thought-title {
    color: #8c2da5;
  }

  article.thought sup a[data-footnote-ref] {
    color: #9ca3af;
    font-weight: 400;
    text-decoration: none;
    padding: 0 0.15em;
  }
  article.thought sup a[data-footnote-ref]:hover,
  article.thought sup a[data-footnote-ref].sn-active {
    text-decoration: underline;
  }

  /* Narrow: notes sit below their thought */
  article.thought .footnotes {
    margin-top: 2rem;
    font-size: 0.85rem;
  }
  article.thought .footnotes::before {
    content: "Notes";
    display: block;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 0.7rem;
    color: #6b7280;
    margin-bottom: 0.75rem;
  }
  article.thought .footnotes h2 {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  article.thought .footnotes ol {
    color: #9ca3af;
    font-weight: 300;
    line-height: 1.6;
    list-style: none;
    padding-left: 1.75rem;
    margin: 0;
    counter-reset: sn;
  }
  article.thought .footnotes li {
    counter-increment: sn;
    position: relative;
    margin: 0 0 0.6rem 0;
  }
  article.thought .footnotes li::before {
    content: counter(sn) ".";
    position: absolute;
    left: -1.75rem;
    width: 1.5rem;
    text-align: right;
    color: #9ca3af;
  }
  article.thought .footnotes p {
    color: #9ca3af;
    font-weight: 300;
    line-height: 1.6;
    margin: 0;
    display: inline;
  }
  article.thought .footnotes a {
    color: #9ca3af;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  article.thought .footnotes a:hover {
    color: #e5e7eb;
  }
  article.thought .footnotes a[data-footnote-backref] {
    color: #6b7280;
    text-decoration: none;
    margin-left: 0.3em;
    cursor: pointer;
  }
  article.thought .footnotes a[data-footnote-backref]:hover {
    color: #e5e7eb;
  }

  /* Wide: notes move into the right margin */
  @media (min-width: 1480px) {
    article.thought {
      position: relative;
    }
    article.thought .footnotes {
      position: absolute;
      top: 0;
      left: calc(100% + 2rem);
      width: 300px;
      margin: 0;
      padding: 0;
    }
    article.thought .footnotes::before {
      display: none;
    }
    article.thought .footnotes ol {
      padding: 0;
    }
    article.thought .footnotes li {
      margin: 0;
      padding: 0.5rem 0 0.5rem 1.75rem;
      opacity: 0.75;
      transition: opacity 0.2s ease;
    }
    article.thought .footnotes li::before {
      content: counter(sn);
      left: 0;
      top: 0.5rem;
      width: auto;
      text-align: left;
      font-size: 0.75rem;
    }
    article.thought .footnotes li:hover,
    article.thought .footnotes li.sn-active {
      opacity: 1;
    }
    article.thought .footnotes a[data-footnote-backref] {
      display: none;
    }
  }
</style>

<Layout
  title="Bastien Faivre - Thoughts"
  description="Reflections, notes, and half-formed ideas"
  schemas={[webPageSchema, breadcrumbSchema]}
>
  <main
    class="w-screen min-h-screen flex flex-col justify-start items-start max-w-3xl mx-auto p-8"
  >
    <a
      href="/"
      class="text-gray-100 bg-gray-900 hover:bg-gray-800 hover:border-primary-500 px-4 py-2 mb-8 border-1 border-solid border-gray-600 rounded-lg font-light inline-block transition-colors duration-200"
    >
      Back
    </a>

    <h1 class="text-4xl font-bold mb-2 text-gray-100">Thoughts</h1>
    <p class="text-lg text-gray-200 font-light mb-12">
      Reflections, notes, and half-formed ideas. The format is inspired by <a
        href="https://en.wikipedia.org/wiki/Meditations"
        class="text-primary-500 hover:underline">Marcus Aurelius' Meditations</a
      >.
    </p>

    {
      entries.length === 0 ? (
        <p class="text-gray-400 font-light">Nothing here yet.</p>
      ) : (
        <div class="flex flex-col gap-12 pb-16 w-full">
          {entries.map(({ entry, Content }, index) => (
            <section id={entry.id} class="scroll-mt-8">
              <header class="thought-heading flex items-baseline justify-between gap-4 mb-4 pb-2 border-b border-gray-700">
                <h2 class="thought-title text-xl font-semibold text-gray-100 m-0 transition-colors">
                  <span class="text-gray-500 font-light mr-2">#{entries.length - index}</span>
                  {entry.data.title}
                  <a
                    href={`#${entry.id}`}
                    class="thought-anchor"
                    aria-label="Link to this thought"
                  >
                    #
                  </a>
                </h2>
                <time
                  datetime={entry.data.date.toISOString()}
                  class="text-sm text-gray-400 font-light whitespace-nowrap"
                >
                  {dateFormatter.format(entry.data.date)}
                </time>
              </header>
              <article class="thought">
                <Content />
              </article>
            </section>
          ))}
        </div>
      )
    }
  </main>
</Layout>
