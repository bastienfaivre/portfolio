---
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import { Icon } from "astro-icon/components";
import { createWebPageSchema, createBreadcrumbSchema } from "../../lib/seo";

const webPageSchema = createWebPageSchema(
  "What I'm currently doing",
  "What I'm currently doing",
  "https://bastienfaivre.com/now",
);

const breadcrumbSchema = createBreadcrumbSchema([
  { name: "Home", url: "https://bastienfaivre.com" },
  { name: "Now" },
]);
---

<script>
  window.addEventListener("load", () => {
    const loader = document.querySelector(".loader") as HTMLElement;
    if (loader) {
      setTimeout(() => {
        loader.classList.add("loader-hidden");
      }, 100);
    }
  });
</script>

<Layout
  title="Bastien Faivre - Now"
  description="What I'm currently doing"
  schemas={[webPageSchema, breadcrumbSchema]}
>
  <main
    class="w-screen min-h-screen flex flex-col justify-start items-start max-w-3xl mx-auto p-8"
  >
    <a href="/" class="mb-8 inline-block">
      <Button>
        <span class="flex items-center gap-2">
          <Icon name="ri:arrow-left-line" class="h-5" />
          Back
        </span>
      </Button>
    </a>
    <h1 class="text-4xl font-bold mb-8 text-gray-100">
      What I'm currently doing
    </h1>

    <section class="mb-8">
      <h2 class="text-2xl font-semibold mb-3 text-gray-100">Professional</h2>
      <p class="text-lg text-gray-200 font-light">
        I'm part of the <a
          href="https://arc.network/"
          target="_blank"
          class="text-primary-500">Arc</a
        > consensus team at <a
          href="https://circle.com/"
          target="_blank"
          class="text-primary-500">Circle</a
        >.
      </p>
    </section>

    <section class="mb-8">
      <h2 class="text-2xl font-semibold mb-3 text-gray-100">Side hustle</h2>
      <p class="text-lg text-gray-200 font-light">
        I'm working on new data standards to help individuals manage and protect
        their data.
      </p>
    </section>
  </main>
</Layout>
