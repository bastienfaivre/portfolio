---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Button from "../../components/Button.astro";
import { Icon } from "astro-icon/components";
import { createWebPageSchema, createBreadcrumbSchema } from "../../lib/seo";
import "../../styles/sidenotes.css";

export async function getStaticPaths() {
  const guides = await getCollection("guides", ({ data }) => !data.draft);
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content } = await render(guide);
const url = `https://bastienfaivre.com/guide/${guide.id}`;

const webPageSchema = createWebPageSchema(
  guide.data.title,
  guide.data.title,
  url,
);

const breadcrumbSchema = createBreadcrumbSchema([
  { name: "Home", url: "https://bastienfaivre.com" },
  { name: "Guides", url: "https://bastienfaivre.com/guides" },
  { name: guide.data.title },
]);

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<script>
  window.addEventListener("load", () => {
    const loader = document.querySelector(".loader") as HTMLElement;
    if (loader) {
      setTimeout(() => {
        loader.classList.add("loader-hidden");
      }, 100);
    }
  });
</script>

<script>
  import { initSidenotes } from "../../lib/sidenotes";

  initSidenotes("article.prose");
</script>

<style is:global>
  article.prose :is(h2, h3, h4) {
    color: #f3f4f6;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }
  article.prose h2 {
    font-size: 1.5rem;
  }
  article.prose h3 {
    font-size: 1.25rem;
  }
  article.prose h4 {
    font-size: 1.05rem;
  }
  article.prose :is(h2, h3, h4) {
    scroll-margin-top: 2rem;
  }
  article.prose p {
    color: #e5e7eb;
    font-weight: 300;
    line-height: 1.75;
    margin: 0 0 1.25rem 0;
  }
  article.prose :is(strong, b) {
    font-weight: 700;
    color: #f3f4f6;
  }
  article.prose :is(em, i) {
    font-style: italic;
  }
  article.prose a {
    color: #8c2da5;
    text-decoration: none;
  }
  article.prose a:hover {
    text-decoration: underline;
  }
  article.prose :is(ul, ol) {
    color: #e5e7eb;
    font-weight: 300;
    line-height: 1.75;
    padding-left: 1.5rem;
    margin: 0 0 1.25rem 0;
  }
  article.prose ul {
    list-style: disc;
  }
  article.prose ol {
    list-style: decimal;
  }
  article.prose code {
    background: #1f2937;
    color: #e5e7eb;
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }
  article.prose pre {
    background: #0f172a;
    border: 1px solid #374151;
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin: 0 0 1.25rem 0;
  }
  article.prose pre code {
    background: transparent;
    padding: 0;
  }
  article.prose blockquote {
    border-left: 3px solid #4b5563;
    padding-left: 1rem;
    margin: 0 0 1.25rem 0;
    color: #d1d5db;
    font-style: italic;
  }
  article.prose img {
    max-width: 100%;
    border-radius: 0.5rem;
  }
  article.prose li > :is(ul, ol) {
    margin: 0.25rem 0 0 0;
  }
  article.prose li:has(> :is(ul, ol)) + li {
    margin-top: 0.5rem;
  }
  article.prose ul ul {
    list-style: circle;
  }

  /* Callouts: <div class="callout callout-{warning,disclaimer,note}"> */
  article.prose .callout {
    border-left: 4px solid;
    border-radius: 0 0.5rem 0.5rem 0;
    padding: 0.875rem 1rem;
    margin: 0 0 1.25rem 0;
  }
  article.prose .callout p {
    margin-bottom: 0.5rem;
  }
  article.prose .callout > :last-child {
    margin-bottom: 0;
  }
  article.prose .callout-warning {
    border-color: #eab308;
    background: rgba(234, 179, 8, 0.08);
  }
  article.prose .callout-disclaimer {
    border-color: #dc2626;
    background: rgba(220, 38, 38, 0.08);
  }
  article.prose .callout-note {
    border-color: #3b82f6;
    background: rgba(59, 130, 246, 0.08);
  }

  article.prose figure {
    margin: 0 0 1.5rem 0;
  }
  article.prose figcaption {
    color: #9ca3af;
    font-size: 0.85rem;
    font-weight: 300;
    text-align: center;
    margin-top: 0.5rem;
  }

  /* Display formulas: fee = <frac> × rate */
  article.prose .formula {
    color: #e5e7eb;
    font-family: "Times New Roman", Times, serif;
    font-size: 1.15rem;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 1.25rem 0;
  }
  article.prose .frac {
    display: inline-flex;
    flex-direction: column;
    text-align: center;
  }
  article.prose .frac > span + span {
    border-top: 1px solid currentColor;
  }

  article.prose .table-wrap {
    overflow-x: auto;
    margin: 0 0 1.25rem 0;
  }
  article.prose table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.9rem;
    color: #e5e7eb;
    font-weight: 300;
  }
  article.prose :is(th, td) {
    border: 1px solid #374151;
    padding: 0.5rem 0.75rem;
    text-align: center;
  }
  article.prose th {
    font-weight: 600;
    color: #f3f4f6;
    background: #111827;
  }
  article.prose td:first-child {
    text-align: left;
  }
  article.prose td.good {
    background: rgba(34, 197, 94, 0.18);
  }
  article.prose td.mid {
    background: rgba(234, 179, 8, 0.18);
  }
  article.prose td.bad {
    background: rgba(239, 68, 68, 0.18);
  }
  article.prose caption {
    caption-side: bottom;
    color: #9ca3af;
    font-size: 0.85rem;
    padding-top: 0.5rem;
  }

  article.prose a.coffee {
    display: inline-block;
    background: #ffdd00;
    color: #000;
    font-weight: 600;
    padding: 0.5rem 1rem;
    border-radius: 0.5rem;
  }
  article.prose a.coffee:hover {
    text-decoration: none;
    filter: brightness(0.95);
  }
</style>

<Layout
  title={`Bastien Faivre - ${guide.data.title}`}
  description={guide.data.title}
  schemas={[webPageSchema, breadcrumbSchema]}
>
  <main
    class="w-screen min-h-screen flex flex-col justify-start items-start max-w-3xl mx-auto p-8"
  >
    <div class="mb-8 w-full flex items-center justify-between gap-4">
      <a href="/guides" class="inline-block">
        <Button>
          <span class="flex items-center gap-2">
            <Icon name="ri:arrow-left-line" class="h-5" />
            All Guides
          </span>
        </Button>
      </a>
      {
        guide.data.pdf && (
          <a
            href={guide.data.pdf}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block"
          >
            <Button>
              <span class="flex items-center gap-2">
                <Icon name="ri:file-pdf-2-line" class="h-5" />
                PDF
              </span>
            </Button>
          </a>
        )
      }
    </div>

    <header class="mb-10 pb-4 border-b border-gray-700 w-full">
      <h1 class="text-4xl font-bold mb-2 text-gray-100">
        {guide.data.title}
      </h1>
      <p class="text-sm text-gray-400 font-light m-0 flex flex-wrap gap-x-2">
        {guide.data.version && <span>v{guide.data.version}</span>}
        {guide.data.version && <span aria-hidden="true">·</span>}
        <span>
          {guide.data.updated ? "Updated " : ""}
          <time
            datetime={(guide.data.updated ?? guide.data.date).toISOString()}
          >
            {dateFormatter.format(guide.data.updated ?? guide.data.date)}
          </time>
        </span>
      </p>
    </header>

    <article class="prose sidenotes w-full">
      <Content />
    </article>
  </main>
</Layout>
